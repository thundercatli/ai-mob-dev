# Build output
build/
.gradle/
.kotlin/
*.apk
*.aab

# Local SDK paths / machine-specific config
local.properties

# Signing material (see keystore.example.properties)
keystore.properties
*.jks
*.keystore

# The frpc binary is not checked in - regenerate it with scripts/build_frpc.sh
# (it is packaged as a .so so Android will extract it as a native library).
*.so

# iOS: the Frpclib.xcframework is regenerated from ios/frpcllib via scripts/build_frpc_ios.sh.
# Committing it bloats the repo (~50MB+) and the Go source is the real source of truth.
ios/Frameworks/

# IDE
.idea/
.zcode/
*.iml
*.iws
*.ipr

# Generated repository snapshot for local AI tooling
repomix-output.xml

# Xcode: 工程文件提交,但每台机器的 user 数据不提交
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# OS
.DS_Store
Thumbs.db
